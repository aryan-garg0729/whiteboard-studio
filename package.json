{
  "name": "whiteboard-studio",
  "version": "0.1.0",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test test/",
    "calibrate:hands": "python3 scripts/calibrate_hands.py",
    "sidecar:install": "python3 -m venv .venv && .venv/bin/pip install -r src/sidecar/requirements.txt",
    "demo": "node scripts/demo-reel.js",
    "demo:frames": "node scripts/demo-reel.js --frames-only",
    "animate:image": "node scripts/animate-image.js",
    "animate:text": "node scripts/animate-text.js",
    "render:project": "node scripts/render-project.js",
    "app": "vite build && electron .",
    "app:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "vite"
  },
  "description": "Whiteboard animation studio",
  "private": true,
  "type": "module",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@xmldom/xmldom": "^0.9.10",
    "opentype.js": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svgpath": "^2.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^41.7.1",
    "vite": "^8.2.0"
  }
}
